{
    default_sni {$PUBLIC_IP}
}

{$PUBLIC_IP} {
    tls {
        issuer acme {
            dir https://acme-v02.api.letsencrypt.org/directory
            profile shortlived
        }
    }

    redir /api /api/ 308

    handle_path /api/* {
        reverse_proxy app:8000
    }

    handle {
        reverse_proxy web:3000
    }
}
